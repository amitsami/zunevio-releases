+++ b/scripts/check_vector_resources.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+"""Check literal shared vector path colors; optionally inspect the built APK."""
+from pathlib import Path
+import re, sys, xml.etree.ElementTree as ET, zipfile
+ROOT = Path(__file__).resolve().parents[1]
+NAMESPACE = '{http://schemas.android.com/apk/res/android}'
+def check(data, label):
+    tree = ET.fromstring(data)
+    for node in tree.iter():
+        for attr in ('fillColor', 'strokeColor'):
+            value = node.get(NAMESPACE + attr)
+            if value is not None:
+                assert re.fullmatch(r'#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})', value), (label, attr, value)
+    return tree
+vectors = list((ROOT / 'sharedUi/src/commonMain/composeResources/drawable').glob('*.xml'))
+assert vectors
+for file in vectors: check(file.read_bytes(), file.name)
+print(f'PASS: {len(vectors)} shared vector XML resources have literal path colors')
+if len(sys.argv) > 1:
+    with zipfile.ZipFile(sys.argv[1]) as archive:
+        prefix = 'assets/composeResources/com.music.bitchord.sharedui.resources/drawable/'
+        names = [n for n in archive.namelist() if n.startswith(prefix) and n.endswith('.xml')]
+        assert names
+        for name in names: check(archive.read(name), name)
+        assert archive.read(prefix + 'ic_logo.xml') == (ROOT / 'sharedUi/src/commonMain/composeResources/drawable/ic_logo.xml').read_bytes()
+        print(f'PASS: {len(names)} APK shared vectors checked; packaged logo matches corrected source')
--- /dev/null
+++ b/sharedUi/src/jvmTest/kotlin/com/music/bitchord/ui/resources/VectorResourceRegressionTest.kt
@@ -0,0 +1,46 @@
+package com.music.bitchord.ui.resources
+
+import androidx.compose.ui.graphics.SolidColor
+import androidx.compose.ui.graphics.vector.VectorPath
+import androidx.compose.ui.unit.Density
+import java.io.File
+import org.jetbrains.compose.resources.decodeToImageVector
+import org.junit.Assert.*
+import org.junit.Test
+
+/** Exercises the same Compose XML parser used by HomeTitle's painterResource. */
+class VectorResourceRegressionTest {
+    private val drawables = File("src/commonMain/composeResources/drawable")
+    private fun logo() = File(drawables, "ic_logo.xml").readBytes()
+
+    @Test fun homeLogoDecodesWithoutAndroidResourceResolution() {
+        val image = logo().decodeToImageVector(Density(1f))
+        assertEquals(48f, image.viewportWidth, 0f)
+        assertEquals(48f, image.viewportHeight, 0f)
+    }
+
+    @Test fun homeLogoRemainsTransparentWithVisibleStroke() {
+        val path = logo().decodeToImageVector(Density(1f)).root[0] as VectorPath
+        assertEquals(0f, (path.fill as SolidColor).value.alpha, 0f)
+        assertEquals(1f, (path.stroke as SolidColor).value.alpha, 0f)
+        assertEquals(3.8f, path.strokeLineWidth, 0f)
+    }
+
+    @Test fun everySharedVectorDecodesAtMultipleDensities() {
+        val vectors = drawables.listFiles { f -> f.extension == "xml" }!!.toList()
+        assertTrue("Shared vector resources must be present", vectors.isNotEmpty())
+        for (file in vectors) for (density in listOf(1f, 2f, 3.5f)) {
+            try { file.readBytes().decodeToImageVector(Density(density)) }
+            catch (e: Exception) { throw AssertionError("Cannot decode ${file.name} at $density", e) }
+        }
+    }
+
+    @Test fun oldAndroidColorReferenceReproducesReportedCrash() {
+        val old = logo().toString(Charsets.UTF_8)
+            .replace("#00000000", "@android:color/transparent").toByteArray()
+        val error = assertThrows(IllegalArgumentException::class.java) {
+            old.decodeToImageVector(Density(1f))
+        }
+        assertTrue(error.message!!.contains("Invalid color value @android:color/transparent"))
+    }
+}
